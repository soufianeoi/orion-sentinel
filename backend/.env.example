PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
USE_REAL_INGESTION=false

# ============================================
# DATA SOURCE API KEYS
# Configure these to enable real data ingestion
# ============================================

# ACLED (Armed Conflict Location & Event Data)
# Get key at: https://acleddata.com/acleddatanew/wp-content/uploads/dlm_uploads/2020/10/ACLED_API-User-Guide_2020.pdf
ACLED_API_KEY=
ACLED_EMAIL=

# NewsAPI.org (100 requests/day free tier)
# Get key at: https://newsapi.org/register
NEWSAPI_KEY=

# Reuters API (requires partnership)
REUTERS_API_KEY=

# Associated Press API
AP_API_KEY=

# Copernicus Open Access Hub (Sentinel-2)
# Register at: https://scihub.copernicus.eu/
COPERNICUS_USER=
COPERNICUS_PASS=

# Planet Labs (requires subscription)
PLANET_API_KEY=

# MarineTraffic AIS API
# Get key at: https://www.marinetraffic.com/en/ais-api-services
MARINETRAFFIC_API_KEY=

# Twitter/X API (requires developer account)
# Get tokens at: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Reddit API
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_SECRET=

# MISP (Malware Information Sharing Platform)
# Self-hosted or community instance
MISP_URL=https://your-misp-instance.com
MISP_API_KEY=

# AlienVault OTX (Open Threat Exchange)
# Get key at: https://otx.alienvault.com/api
ALIENVAULT_OTX_KEY=

# Database (for production persistence)
DATABASE_URL=postgresql://osint:osint_secure_2026@postgres:5432/osint_platform
REDIS_URL=redis://redis:6379
